@model List<aspnetcoremvc2.Models.Person>

<table>
    <tr>
        <th scope="col">ID</th>
        <th scope="col">First name</th>
        <th scope="col">Last name</th>
        <th scope="col">Gender</th>
        <th scope="col">Date of birth</th>
        <th scope="col">Phone number</th>
        <th scope="col">Birthplace</th>
        <th scope="col">Is graduated</th>
    </tr>

    @if (Model.Count == 0) {
        <tr>
            <td class="text-center" colspan="8">No data</td>
        </tr>
    } else {
        @foreach (Person person in Model) {
            <tr>
                <td>@person.Id</td>
                <td>
                    <a asp-controller="Rookie" asp-action="GetDetails" asp-route-id="@person.Id">
                        @person.FirstName
                    </a>
                </td>
                <td>@person.LastName</td>
                <td>@person.Gender.ToString()</td>
                <td>@person.DateOfBirth.ToString()</td>
                <td>@person.PhoneNumber</td>
                <td>@person.BirthPlace</td>
                <td>@(person.IsGraduated ? "Yes" : "No")</td>
            </tr>
        }
    }

</table>